# Passwort für die PostgreSQL-Datenbank (mit openssl rand -hex 24 erzeugen)
LUNEFI_DB_PASSWORD=

# Google-Login (optional): OAuth-Client-ID aus der Google Cloud Console
# (Typ Webanwendung, autorisierte JavaScript-Quellen:
#  https://lunefi.duckdns.org und http://localhost:5174)
LUNEFI_GOOGLE_CLIENT_ID=

# Wer mit Google rein darf: Mail-Adresse = App-Name, Komma-getrennt.
# Gmail zählt ohne Punkte, googlemail.com gilt wie gmail.com.
LUNEFI_GOOGLE_ZUORDNUNG=deine@gmail.com=Alex,anne@gmail.com=Kim
